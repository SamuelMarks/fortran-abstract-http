root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{f,for,inc}]
max_line_length = 72
indent_size = 6

[*.{f90,f95,f03,f08,f18,f23}]
max_line_length = 120
indent_size = 2

[Makefile]
indent_style = tab

[*.py]
indent_size = 4
