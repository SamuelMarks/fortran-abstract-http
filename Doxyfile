PROJECT_NAME           = "fortran-abstract-http"
PROJECT_BRIEF          = "Multi-standard FORTRAN I through Fortran 2023 FFI SDK for c-abstract-http"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
INPUT                  = include src/ffi generated/c_abstract_http_fortran_shim.h generated/c_abstract_http_fortran_shim.c
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = NO_DISCARD= \
                         FAH_NO_DISCARD= \
                         FAH_API= \
                         FAH_FC_GLOBAL(low,UP)=low##_ \
                         FAH_FC_GLOBAL_(low,UP)=low##_ \
                         C_ABSTRACT_HTTP_API= \
                         FAH_TEST_OOM=1
